# Set these in your shell or your host's secret settings. The app does not load .env files.
# Never put a key in docs/ or a GitHub Pages deployment.

# AI answers (free tier): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides
# LLM_PROVIDER=gemini            # gemini | groq | openrouter | ollama | openai
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_FALLBACK_MODEL=gemini-3.1-flash-lite   # 'none' to disable
# EMBED_MODEL=gemini-embedding-001           # 'none' for keyword-only retrieval
# LLM_TIMEOUT_MS=20000
# LLM_RETRIES=2
# LLM_DISABLED=true              # force keyword-only answers

# Privacy: only records marked synthetic are sent to the provider unless this is true.
# ALLOW_REAL_FEEDBACK_TO_PROVIDER=false

# Server
PORT=8767
# HOST=0.0.0.0                   # hosted deployments
# PUBLIC_HOSTS=feedback-lens.onrender.com
# ALLOWED_ORIGINS=https://karan00023.github.io
# RATE_LIMIT_PER_MINUTE=20

# Behind an HTTPS proxy (some corporate or sandboxed networks), Node's fetch needs:
# NODE_USE_ENV_PROXY=1
